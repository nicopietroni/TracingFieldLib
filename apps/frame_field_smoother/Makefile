	@$(QMAKE) -o Makefile frame_field_smoother.pro -spec macx-clang CONFIG+=qtquickcompiler

qmake_all: FORCE

frame_field_smoother.app/Contents/PkgInfo: 
	@test -d frame_field_smoother.app/Contents || mkdir -p frame_field_smoother.app/Contents
	@$(DEL_FILE) frame_field_smoother.app/Contents/PkgInfo
	@echo "APPL????" > frame_field_smoother.app/Contents/PkgInfo
frame_field_smoother.app/Contents/Resources/empty.lproj: 
	@test -d frame_field_smoother.app/Contents/Resources || mkdir -p frame_field_smoother.app/Contents/Resources
	@touch frame_field_smoother.app/Contents/Resources/empty.lproj
	
frame_field_smoother.app/Contents/Info.plist: 
	@test -d frame_field_smoother.app/Contents || mkdir -p frame_field_smoother.app/Contents
	@$(DEL_FILE) frame_field_smoother.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.frame-field-smoother,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.frame-field-smoother,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.14,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,frame_field_smoother,g" -e "s,@LIBRARY@,frame_field_smoother,g" -e "s,\$${EXECUTABLE_NAME},frame_field_smoother,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /Users/134750/Qt/6.3.0/macos/mkspecs/macx-clang/Info.plist.app >frame_field_smoother.app/Contents/Info.plist

